msgid "Admin help tabs"
msgstr ""

#: admin/settings-page-output.php:137
msgid "Removes all help tabs from the contextual help for the screen."
msgstr ""

#: admin/settings-page-output.php:140
msgid "Remove admin help tabs?"
msgstr ""

#: admin/settings-page-output.php:146
msgid "WP Logo sub-menu & Thank you message"
msgstr ""

#: admin/settings-page-output.php:147
msgid "This will remove \"About Wordpress\" sub-menu from top of admin menu and \"Thank you\" message at the bottom of footer area in admin panel."
msgstr ""

#: admin/settings-page-output.php:149
msgid "Disable WP sub-menu and thank you message?"
msgstr ""

#: admin/settings-page-output.php:155
msgid "Import/Export Pages"
msgstr ""

#: admin/settings-page-output.php:156
