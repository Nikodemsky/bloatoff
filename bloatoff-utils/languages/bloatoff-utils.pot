msgid "Utilities"
msgstr ""

#: admin/settings-page-output.php:189
msgid "Comments system removal"
msgstr ""

#: admin/settings-page-output.php:190
msgid "This will disable the comments system completely, set proper redirects, and remove admin pages for comment management."
msgstr ""

#. Translators: %1$s - <strong>, :%2$s - </strong>

#: admin/settings-page-output.php:192
msgid "%1$sWARNING:%2$s If you're connected to an external comment system like Disqus via native comment support (for example, through the official Disqus plugin), this will also remove/disable that connection."
msgstr ""

#: admin/settings-page-output.php:194
msgid "Disable built-in WordPress comment system?"
msgstr ""

#: admin/settings-page-output.php:200
msgid "Widgets removal"
msgstr ""

#: admin/settings-page-output.php:201
msgid "This will remove the native widget system (from the Appearance admin menu)."
msgstr ""

#: admin/settings-page-output.php:204
msgid "Remove widget support?"
msgstr ""

#: admin/settings-page-output.php:210
msgid "oEmbed restriction"
msgstr ""

#: admin/settings-page-output.php:211
msgid "It will disable oEmbed on site, while keeping it enabled for external platforms/apps/websites."
msgstr ""

#: admin/settings-page-output.php:214
msgid "Restrict oEmbed?"
msgstr ""

#: admin/settings-page-output.php:220
msgid "Self-pingbacks"
msgstr ""

#: admin/settings-page-output.php:221
msgid "Disables self-pingbacks after new post creation or internal linking."
msgstr ""

#: admin/settings-page-output.php:224
msgid "Disable self-pingbacks?"
msgstr ""

#: admin/settings-page-output.php:230
msgid "Image Processing engine"
msgstr ""

#: admin/settings-page-output.php:231
msgid "WordPress uses Imagick by default if available. This option forces the use of GD, which is generally faster. The downside is that GD supports far fewer image formats, and image quality may drop"
msgstr ""

#. Translators: %1$s - <strong>, :%2$s - </strong>

#: admin/settings-page-output.php:233
msgid "%1$sWARNING:%2$s Since the GD PHP extension requires additional configuration for WebP/AVIF formats, those may not be available for plugins like CompressX or even for native processing in the media library."
msgstr ""

#: admin/settings-page-output.php:236
msgid "Force GD Image Processing engine?"
msgstr ""

#: admin/settings-page-output.php:242
msgid "Tags taxonomy removal"
msgstr ""

#: admin/settings-page-output.php:243
msgid "This will remove the native tags taxonomy from the default post type (Posts → Tags in the admin menu). Many non-blog websites don't need tags at all."
msgstr ""

#. Translators: %1$s - <strong>, :%2$s - </strong>

#: admin/settings-page-output.php:245
msgid "%1$sWARNING:%2$s If you have any tags indexed and at least some traffic comes through them — this option can affect your position on search engines like Google."
msgstr ""

#: admin/settings-page-output.php:248
msgid "Unregister default tags taxonomy?"
msgstr ""

#: admin/settings-page-output.php:254
msgid "Author archives"
msgstr ""

#. Translators: %3$s3 - <br>

#: admin/settings-page-output.php:256
msgid "Author archive pages can be considered redundant on installations where posts are not categorized by WP users (as authors). %3$s Since author archives are part of WP Core and can't be \"removed\" per se, this function is limited to:%3$s 1. Redirection of any author archive page queries to the homepage (301 redirect); %3$s Removal of author links from functions like author_link/the_author_posts_link; %3$s 3. Removal of authors from native sitemaps (if actively used). %3$s Note: Most of the time, author archive indexation can be configured in the settings of most popular SEO plugins."
msgstr ""

#. Translators: %1$s - <strong>, :%2$s - </strong>

#: admin/settings-page-output.php:258
msgid "%1$sWARNING:%2$s If you have author pages indexed and they are vital for your website's blog categorization — this option can affect your position on search engines like Google."
msgstr ""

#: admin/settings-page-output.php:261
msgid "Disable author archives?"
msgstr ""

#: admin/settings-page-output.php:267
msgid "WordPress Heartbeat API"
msgstr ""

#: admin/settings-page-output.php:268
msgid "The Heartbeat API is used for autosaving, post locking, and other real-time features. Increasing the interval reduces server load but may cause issues with functionality that heavily relies on the Heartbeat API."
msgstr ""

#: admin/settings-page-output.php:269
msgid "This reduces server requests and CPU usage on both the frontend and backend."
msgstr ""

#: admin/settings-page-output.php:271
msgid "Modify WordPress Heartbeat interval?"
msgstr ""

#: admin/settings-page-output.php:272
msgid "Interval (seconds):"
msgstr ""

#: admin/settings-page-output.php:277
msgid "Default: 15 seconds. Range: 1-3600 seconds (1 hour)."
msgstr ""

#. Translators: %1$s - <strong>, :%2$s - </strong>

#: admin/settings-page-output.php:279
msgid "%1$sWARNING:%2$s Be very careful when changing this interval — it could break some essential functionality on your website."
msgstr ""

#: admin/settings-page-output.php:285
msgid "Revisions"
msgstr ""

#. Translators: %1$s - <strong>, :%2$s - </strong>, %3$s3 - <br>

#: admin/settings-page-output.php:287
msgid "This option allows you to change the global number of revisions (including all post types that support revisions) per post/page. By default, WordPress does not limit the number of revisions, which usually makes the database much bigger than it should be — especially on content-heavy websites like blogs. This leads to worse website load times.%3$s How it works:%3$s %1$s-1 / Off%2$s - Default, no limit on revisions.%3$s %1$s0%2$s - Revisions are disabled. %3$s %1$s1-999%2$s - Revisions for all post types are limited to this number.%3$s Note: Revisions won't be removed right away once this option is enabled — you need to update each post/page to have its revisions removed. If you want to clear your installation of revisions globally, try using plugins like \"WP-Sweep\" or \"Optimize Database after Deleting Revisions.\""
msgstr ""

#: admin/settings-page-output.php:288
msgid "Reduces load on the database and its size in the long run."
msgstr ""

#: admin/settings-page-output.php:290
msgid "Modify global revisions number?"
msgstr ""

#: admin/settings-page-output.php:291
msgid "Revisions:"
msgstr ""

#: admin/settings-page-output.php:296
msgid "Default: -1 (unlimited). Range: 1-99."
msgstr ""

#. Translators: %1$s - <strong>, :%2$s - </strong>

#: admin/settings-page-output.php:298
msgid "%1$sWARNING:%2$s This option is not designed to override specific post type capabilities — if a post type doesn't support revisions, this option won't change that."
msgstr ""

